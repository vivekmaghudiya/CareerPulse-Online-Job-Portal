# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Local Example:
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal
# Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jobportal?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Optional Admin Seed Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin23@jobportal.com
ADMIN_PASSWORD=AdminPassword123!
