# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Local Example:
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal
# Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jobportal?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Optional Admin Seed Credentials
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional Cloud Storage for Resumes (Required for resume file uploads on Vercel)
# Sign up for free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

