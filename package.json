{
  "name": "online-job-portal",
  "version": "1.0.0",
  "description": "Full-stack Online Job Portal web application built with Node.js, Express, EJS, Bootstrap 5, and MongoDB",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "seed": "node seeder.js",
    "test": "node --test tests/*.test.js",
    "test:admin": "node --test tests/admin.test.js",
    "test:e2e": "node tests/live_admin_e2e.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "keywords": [
    "job-portal",
    "nodejs",
    "express",
    "mongodb",
    "ejs",
    "bootstrap5",
    "careers",
    "recruitment"
  ],
  "author": "",
