<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-4">
  <div class="container">
    <!-- Header & Quick Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-1">
          Employer Dashboard 🏢
        </h1>
        <p class="text-muted small mb-0">
          Managing postings for <strong><%= user.companyName || user.name %></strong>
        </p>
      </div>

      <div class="d-flex gap-2">
        <a href="/jobs/new" class="btn btn-primary d-inline-flex align-items-center gap-1">
          <i class="bi bi-plus-circle-fill"></i> Post New Vacancy
        </a>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#profileModal">
          <i class="bi bi-gear me-1"></i> Company Profile
        </button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-briefcase"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.totalJobs %></h3>
            <span class="text-muted small">Total Postings</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
            <i class="bi bi-check-circle"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.activeJobs %></h3>
            <span class="text-muted small">Active Vacancies</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
            <i class="bi bi-people"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.totalApplications %></h3>
            <span class="text-muted small">Applications Received</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-star"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.totalShortlisted %></h3>
            <span class="text-muted small">Shortlisted Candidates</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Job Vacancies Management Table -->
    <div class="card-modern shadow-sm mb-4">
      <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">
          <i class="bi bi-list-task text-primary me-2"></i> Manage Job Postings
        </h5>
        <a href="/jobs/new" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-plus"></i> Add Job
        </a>
      </div>

      <div class="p-0">
        <% if (jobs && jobs.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light text-muted small text-uppercase">
                <tr>
                  <th scope="col" class="ps-4">Job Title & Details</th>
                  <th scope="col">Status</th>
                  <th scope="col">Applications</th>
                  <th scope="col">Date Posted</th>
                  <th scope="col" class="text-end pe-4">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% jobs.forEach(job => { %>
                  <tr>
                    <!-- Job Title -->
                    <td class="ps-4">
                      <div class="fw-bold text-dark">
                        <a href="/jobs/<%= job._id %>" class="text-decoration-none text-dark hover-primary">
                          <%= job.title %>
                        </a>
                      </div>
                      <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                        <span><i class="bi bi-geo-alt"></i> <%= job.location %></span>
                        <span>&bull;</span>
                        <span class="badge-job-type py-0 px-2"><%= job.jobType %></span>
                        <span>&bull;</span>
                        <span class="text-primary fw-semibold"><%= job.salary %></span>
                      </div>
                    </td>

                    <!-- Status -->
                    <td>
                      <% if (job.status === 'active') { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                          <i class="bi bi-dot"></i> Active
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                          Closed
                        </span>
                      <% } %>
                    </td>

                    <!-- Applications Received -->
                    <td>
                      <a href="/dashboard/employer/jobs/<%= job._id %>/applications" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1">
                        <i class="bi bi-people-fill text-primary"></i>
                        <strong><%= job.applicationCount %></strong>
                        <span class="text-muted small">Applicants</span>
                      </a>
                    </td>

                    <!-- Date Posted -->
                    <td>
                      <small class="text-dark"><%= formatDate(job.createdAt) %></small>
                      <small class="text-muted d-block" style="font-size: 0.75rem;"><%= timeAgo(job.createdAt) %></small>
                    </td>

                    <!-- Actions -->
                    <td class="text-end pe-4">
                      <div class="btn-group">
                        <a href="/dashboard/employer/jobs/<%= job._id %>/applications" class="btn btn-sm btn-outline-primary" title="View Applicants">
                          <i class="bi bi-people"></i>
                        </a>
                        <a href="/jobs/<%= job._id %>" class="btn btn-sm btn-outline-secondary" title="View Details">
                          <i class="bi bi-eye"></i>
                        </a>
                        <a href="/jobs/<%= job._id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit Job">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/jobs/<%= job._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this job listing?');" class="d-inline">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Job">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-briefcase text-muted display-4"></i>
            <h5 class="fw-bold mt-3">No jobs posted yet</h5>
            <p class="text-muted small">Start attracting qualified candidates by posting your first job vacancy.</p>
            <a href="/jobs/new" class="btn btn-primary mt-2">
              <i class="bi bi-plus-lg me-1"></i> Post a Job Now
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Edit Company Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="profileModalLabel">Update Employer Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/dashboard/profile" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="companyName" class="form-label">Company / Organization Name</label>
            <input type="text" class="form-control" id="companyName" name="companyName" value="<%= user.companyName || '' %>" required>
          </div>
          <div class="mb-3">
            <label for="name" class="form-label">Recruiter / Contact Person Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required>
          </div>
          <div class="mb-3">
            <label for="phone" class="form-label">Contact Phone</label>
            <input type="text" class="form-control" id="phone" name="phone" value="<%= user.phone || '' %>">
          </div>
          <div class="mb-3">
            <label for="bio" class="form-label">About Company / Organization</label>
            <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Brief company summary..."><%= user.bio || '' %></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4">Save Company Profile</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
