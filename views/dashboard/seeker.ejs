<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-4">
  <div class="container">
    <!-- Header Greeting -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
      <div>
        <h1 class="h3 fw-bold mb-1">
          Welcome, <%= user.name %>! 👋
        </h1>
        <p class="text-muted small mb-0">Track your submitted job applications and update your career profile.</p>
      </div>

      <div class="d-flex gap-2">
        <a href="/jobs" class="btn btn-primary d-inline-flex align-items-center gap-1">
          <i class="bi bi-search"></i> Browse Jobs
        </a>
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#profileModal">
          <i class="bi bi-person-gear me-1"></i> Edit Profile
        </button>
      </div>
    </div>

    <!-- Application Stats Counter Cards -->
    <div class="row g-3 mb-4">
      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-send-check"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.total %></h3>
            <span class="text-muted small">Total Applied</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
            <i class="bi bi-hourglass-split"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.pending %></h3>
            <span class="text-muted small">Under Review</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
            <i class="bi bi-bookmark-star"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.shortlisted %></h3>
            <span class="text-muted small">Shortlisted</span>
          </div>
        </div>
      </div>

      <div class="col-xl-3 col-sm-6">
        <div class="stat-card">
          <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
            <i class="bi bi-trophy"></i>
          </div>
          <div>
            <h3 class="fw-bold mb-0"><%= stats.accepted %></h3>
            <span class="text-muted small">Offers Accepted</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content: Applications Table & Profile Card -->
    <div class="row g-4">
      <!-- Applications Table -->
      <div class="col-lg-8">
        <div class="card-modern shadow-sm">
          <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
              <i class="bi bi-journal-text text-primary me-2"></i> My Submitted Applications
            </h5>
            <span class="badge bg-light text-dark border"><%= applications.length %> entries</span>
          </div>

          <div class="p-0">
            <% if (applications && applications.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light text-muted small text-uppercase">
                    <tr>
                      <th scope="col" class="ps-4">Job Title & Company</th>
                      <th scope="col">Date Applied</th>
                      <th scope="col">Resume Sent</th>
                      <th scope="col">Application Status</th>
                      <th scope="col" class="text-end pe-4">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% applications.forEach(app => { %>
                      <tr>
                        <!-- Job Title -->
                        <td class="ps-4">
                          <% if (app.jobId) { %>
                            <div class="fw-bold text-dark">
                              <a href="/jobs/<%= app.jobId._id %>" class="text-decoration-none text-dark hover-primary">
                                <%= app.jobId.title %>
                              </a>
                            </div>
                            <small class="text-muted d-flex align-items-center gap-1">
                              <i class="bi bi-building"></i> <%= app.jobId.company %> &bull; <i class="bi bi-geo-alt"></i> <%= app.jobId.location %>
                            </small>
                          <% } else { %>
                            <span class="text-muted fst-italic">Job posting closed or deleted</span>
                          <% } %>
                        </td>

                        <!-- Date -->
                        <td>
                          <small class="text-dark"><%= formatDate(app.appliedAt) %></small>
                          <small class="text-muted d-block" style="font-size: 0.75rem;"><%= timeAgo(app.appliedAt) %></small>
                        </td>

                        <!-- Resume link -->
                        <td>
                          <a href="<%= app.resumePath %>" target="_blank" download class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span class="text-truncate" style="max-width: 100px;"><%= app.resumeOriginalName || 'Resume' %></span>
                          </a>
                        </td>

                        <!-- Status -->
                        <td>
                          <span class="badge badge-status-<%= app.status.toLowerCase() %>">
                            <%= app.status %>
                          </span>
                        </td>

                        <!-- Action -->
                        <td class="text-end pe-4">
                          <% if (app.jobId) { %>
                            <a href="/jobs/<%= app.jobId._id %>" class="btn btn-sm btn-outline-primary">
                              View Job
                            </a>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="bi bi-briefcase text-muted display-4"></i>
                <h5 class="fw-bold mt-3">No applications submitted yet</h5>
                <p class="text-muted small">Explore available vacancies and start applying to launch your career!</p>
                <a href="/jobs" class="btn btn-primary mt-2">Browse Available Jobs</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Column: User Profile Overview -->
      <div class="col-lg-4">
        <div class="card-modern p-4 mb-4">
          <div class="text-center mb-3">
            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px; font-size: 1.8rem; font-weight: 700;">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <h5 class="fw-bold mb-0"><%= user.name %></h5>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mt-1">
              Job Seeker
            </span>
          </div>

          <div class="border-top pt-3 small">
            <div class="mb-2">
              <span class="text-muted d-block">Email:</span>
              <strong class="text-dark"><%= user.email %></strong>
            </div>
            <div class="mb-2">
              <span class="text-muted d-block">Phone:</span>
              <strong class="text-dark"><%= user.phone || 'Not provided' %></strong>
            </div>
            <div class="mb-2">
              <span class="text-muted d-block">Member Since:</span>
              <strong class="text-dark"><%= formatDate(user.createdAt) %></strong>
            </div>
            <div class="mb-3">
              <span class="text-muted d-block">Bio / Objective:</span>
              <p class="text-muted mb-0"><%= user.bio || 'Add a personal bio or statement in Edit Profile.' %></p>
            </div>
          </div>

          <div class="border-top pt-3 d-grid gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#profileModal">
              <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </button>
            <a href="/auth/logout" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-box-arrow-right me-1"></i> Log Out
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Edit Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="profileModalLabel">Update Your Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/dashboard/profile" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required>
          </div>
          <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input type="text" class="form-control" id="phone" name="phone" value="<%= user.phone || '' %>" placeholder="+1 (555) 000-0000">
          </div>
          <div class="mb-3">
            <label for="bio" class="form-label">Bio / Summary</label>
            <textarea class="form-control" id="bio" name="bio" rows="3" placeholder="Tell recruiters about yourself..."><%= user.bio || '' %></textarea>
          </div>
        </div>
        <div class="modal-footer border-top bg-light">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary px-4">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
