<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-4">
  <div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/jobs" class="text-decoration-none">Jobs</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= job.title %></li>
      </ol>
    </nav>

    <!-- Header Job Banner Card -->
    <div class="card-modern p-4 mb-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
        <div class="d-flex align-items-start gap-3">
          <div class="company-avatar" style="width: 64px; height: 64px; font-size: 1.6rem;">
            <%= job.company.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
              <span class="badge-job-type"><%= job.jobType %></span>
              <span class="badge-job-type"><%= job.category %></span>
              <% if (job.isFeatured) { %>
                <span class="badge-featured"><i class="bi bi-star-fill text-warning"></i> Featured</span>
              <% } %>
            </div>
            <h1 class="h3 fw-bold mb-1"><%= job.title %></h1>
            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
              <span><i class="bi bi-building me-1 text-primary"></i> <strong><%= job.company %></strong></span>
              <span><i class="bi bi-geo-alt me-1 text-primary"></i> <%= job.location %></span>
              <span><i class="bi bi-clock me-1"></i> Posted <%= timeAgo(job.createdAt) %></span>
            </div>
          </div>
        </div>

        <div class="text-md-end w-100 w-md-auto pt-2 pt-md-0 border-top border-md-0">
          <div class="h4 fw-bold text-primary mb-2"><%= job.salary %></div>

          <% if (isOwner) { %>
            <div class="d-flex gap-2">
              <a href="/dashboard/employer/jobs/<%= job._id %>/applications" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-people me-1"></i> View Applicants
              </a>
              <a href="/jobs/<%= job._id %>/edit" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit
              </a>
              <form action="/jobs/<%= job._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this job listing?');" class="d-inline">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </div>
          <% } else if (currentUser && currentUser.role === 'job_seeker') { %>
            <% if (existingApplication) { %>
              <div class="alert alert-info py-2 px-3 mb-0 text-start d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill text-primary fs-5"></i>
                <div>
                  <small class="d-block fw-bold">Application Submitted</small>
                  <span class="badge badge-status-<%= existingApplication.status.toLowerCase() %>">
                    Status: <%= existingApplication.status %>
                  </span>
                </div>
              </div>
            <% } else { %>
              <button type="button" class="btn btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#applyModal">
                <i class="bi bi-send-fill me-1"></i> Apply Now
              </button>
            <% } %>
          <% } else if (!currentUser) { %>
            <a href="/auth/login" class="btn btn-primary px-4 py-2">
              Log in to Apply
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Main Content & Sidebar -->
    <div class="row g-4">
      <!-- Left Column: Details -->
      <div class="col-lg-8">
        <div class="card-modern p-4 mb-4">
          <h4 class="fw-bold mb-3"><i class="bi bi-file-text text-primary me-2"></i> Job Description</h4>
          <div class="text-secondary lh-lg mb-4" style="white-space: pre-line;">
            <%= job.description %>
          </div>

          <h4 class="fw-bold mb-3"><i class="bi bi-check2-circle text-primary me-2"></i> Requirements & Qualifications</h4>
          <div class="text-secondary lh-lg" style="white-space: pre-line;">
            <%= job.requirements %>
          </div>
        </div>

        <!-- Call to Action Banner -->
        <% if (currentUser && currentUser.role === 'job_seeker' && !existingApplication) { %>
          <div class="p-4 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div>
              <h5 class="fw-bold text-primary mb-1">Interested in this position?</h5>
              <p class="text-muted small mb-0">Submit your resume and cover letter to get reviewed by <%= job.company %>.</p>
            </div>
            <button type="button" class="btn btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#applyModal">
              Apply Now
            </button>
          </div>
        <% } %>
      </div>

      <!-- Right Column: Company Overview & Related Jobs -->
      <div class="col-lg-4">
        <!-- Company Overview Card -->
        <div class="card-modern p-4 mb-4">
          <h5 class="fw-bold mb-3">About The Employer</h5>
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="company-avatar">
              <%= job.company.charAt(0).toUpperCase() %>
            </div>
            <div>
              <h6 class="fw-bold mb-0"><%= job.company %></h6>
              <small class="text-muted"><%= job.location %></small>
            </div>
          </div>
          <% if (job.employerId && job.employerId.bio) { %>
            <p class="text-muted small mb-3"><%= job.employerId.bio %></p>
          <% } else { %>
            <p class="text-muted small mb-3">Verified employer on CareerPulse hiring for talent in <%= job.category %>.</p>
          <% } %>
          <div class="border-top pt-3 text-muted small">
            <div class="d-flex justify-content-between mb-2">
              <span>Category:</span>
              <strong class="text-dark"><%= job.category %></strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Job Type:</span>
              <strong class="text-dark"><%= job.jobType %></strong>
            </div>
            <div class="d-flex justify-content-between">
              <span>Salary:</span>
              <strong class="text-primary"><%= job.salary %></strong>
            </div>
          </div>
        </div>

        <!-- Related Jobs -->
        <% if (relatedJobs && relatedJobs.length > 0) { %>
          <div class="card-modern p-4">
            <h5 class="fw-bold mb-3">Similar Positions</h5>
            <div class="d-flex flex-column gap-3">
              <% relatedJobs.forEach(rel => { %>
                <div class="border-bottom pb-3">
                  <h6 class="fw-bold mb-1">
                    <a href="/jobs/<%= rel._id %>" class="text-decoration-none text-dark hover-primary small">
                      <%= rel.title %>
                    </a>
                  </h6>
                  <div class="text-muted small d-flex justify-content-between">
                    <span><%= rel.company %></span>
                    <span class="text-primary fw-semibold"><%= rel.salary %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<!-- Apply Job Modal (for Job Seekers) -->
<% if (currentUser && currentUser.role === 'job_seeker' && !existingApplication) { %>
  <div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold" id="applyModalLabel">
            Apply for <%= job.title %>
          </h5>
          <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/jobs/<%= job._id %>/apply" method="POST" enctype="multipart/form-data">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" value="<%= currentUser.name %>" readonly disabled>
            </div>

            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <input type="email" class="form-control" value="<%= currentUser.email %>" readonly disabled>
            </div>

            <div class="mb-3">
              <label for="resume" class="form-label">
                Upload Resume / CV <span class="text-danger">*</span>
              </label>
              <input type="file" class="form-control" id="resume" name="resume" accept=".pdf,.doc,.docx" required>
              <small class="text-muted">Accepted formats: PDF, DOC, DOCX (Max 5MB)</small>
            </div>

            <div class="mb-3">
              <label for="coverLetter" class="form-label">
                Cover Letter / Personal Statement <span class="text-muted fw-normal">(Optional)</span>
              </label>
              <textarea
                class="form-control"
                id="coverLetter"
                name="coverLetter"
                rows="4"
                placeholder="Briefly explain why you are a great fit for this position..."
              ></textarea>
            </div>
          </div>

          <div class="modal-footer border-top bg-light">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary px-4">
              Submit Application <i class="bi bi-send-fill ms-1"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
