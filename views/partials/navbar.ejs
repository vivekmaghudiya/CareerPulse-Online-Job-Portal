<nav class="navbar navbar-expand-lg navbar-custom">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-icon">
        <i class="bi bi-briefcase-fill"></i>
      </span>
      <span>Career<span class="text-primary">Pulse</span></span>
    </a>
    
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/jobs' ? 'active' : '' %>" href="/jobs">
            <i class="bi bi-search me-1"></i> Browse Jobs
          </a>
        </li>
      </ul>
      
      <div class="d-flex align-items-center gap-2">
        <% if (!currentUser) { %>
          <a href="/auth/login" class="btn btn-outline-primary px-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
          </a>
          <a href="/auth/register" class="btn btn-primary px-3">
            <i class="bi bi-person-plus me-1"></i> Register
          </a>
        <% } else { %>
          <% if (currentUser.role === 'employer') { %>
            <a href="/jobs/new" class="btn btn-outline-primary d-none d-md-inline-flex align-items-center gap-1 me-2">
              <i class="bi bi-plus-circle-fill"></i> Post a Job
            </a>
          <% } %>

          <div class="dropdown">
            <button class="btn btn-light border dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.85rem; font-weight: 700;">
                <%= currentUser.name.charAt(0).toUpperCase() %>
              </span>
              <span class="fw-semibold text-truncate" style="max-width: 140px;"><%= currentUser.name %></span>
              <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;">
                <%= currentUser.role === 'job_seeker' ? 'Seeker' : currentUser.role %>
              </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="userMenuButton">
              <li class="px-3 py-2 border-bottom">
                <small class="text-muted d-block">Signed in as</small>
                <strong class="text-truncate d-block" style="max-width: 200px;"><%= currentUser.email %></strong>
              </li>
              
              <% if (currentUser.role === 'job_seeker') { %>
                <li>
                  <a class="dropdown-item py-2" href="/dashboard/seeker">
                    <i class="bi bi-speedometer2 me-2 text-primary"></i> My Dashboard
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="/jobs">
                    <i class="bi bi-compass me-2 text-primary"></i> Find More Jobs
                  </a>
                </li>
              <% } else if (currentUser.role === 'employer') { %>
                <li>
                  <a class="dropdown-item py-2" href="/dashboard/employer">
                    <i class="bi bi-speedometer2 me-2 text-primary"></i> Employer Dashboard
                  </a>
                </li>
                <li>
                  <a class="dropdown-item py-2" href="/jobs/new">
                    <i class="bi bi-plus-square me-2 text-primary"></i> Post New Vacancy
                  </a>
                </li>
              <% } else if (currentUser.role === 'admin') { %>
                <li>
                  <a class="dropdown-item py-2 text-danger fw-semibold" href="/dashboard/admin">
                    <i class="bi bi-shield-lock-fill me-2"></i> Admin Control Panel
                  </a>
                </li>
              <% } %>
              
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item py-2 text-danger" href="/auth/logout">
                  <i class="bi bi-box-arrow-right me-2"></i> Log Out
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
